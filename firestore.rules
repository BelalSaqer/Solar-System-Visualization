rules_version = '2';

// Firestore here is only used server-side by the chatWithAssistant Cloud
// Function (via the Admin SDK, which bypasses these rules entirely) to
// track a per-IP rate limit. No client ever needs direct access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
